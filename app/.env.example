# Copy to .env and fill in. Never commit the real .env.
#
# De database staat momenteel uit, dus alleen SECRET_KEY is nodig. De
# POSTGRES_* regels hieronder zijn er voor als je hem weer aanzet.
#
# IMPORTANT: POSTGRES_USER and POSTGRES_PASSWORD only create a role the very
# first time the postgres_data volume is initialised. On an existing volume
# they are ignored by the database, but the web service still builds
# DATABASE_URL from them. If they drift from the role actually stored in the
# cluster you get:
#
#   FATAL:  password authentication failed for user "..."
#   DETAIL:  Role "..." does not exist.
#
# See DOCKER.md for how to look up the real role and reset its password.

POSTGRES_USER=change_me
# Avoid : / @ ? # and % in the password, or URL-encode them. The value is
# interpolated straight into the DATABASE_URL connection string.
POSTGRES_PASSWORD=change_me

# Flask session signing key.
SECRET_KEY=change_me
