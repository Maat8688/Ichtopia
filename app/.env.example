# Kopieer naar .env en vul in. .env staat in .gitignore en hoort nooit in git.

# Domeinnaam waarop de site draait (moet in DNS naar deze server wijzen).
DOMAIN=topo.example.nl

# Lange willekeurige strings, bijvoorbeeld uit: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_USER=topo
POSTGRES_PASSWORD=

# Code waarmee docenten een quiz kunnen hosten en een docentaccount kunnen maken.
KAHOOT_HOST_CODE=

# Alerts van src/monitor.py (leeg = uit). Kies een lange, niet te raden topic.
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=

# Optioneel: grenzen voor oefensessies in het geheugen.
# MAX_PRACTICE_SESSIONS=400
# PRACTICE_SESSION_IDLE_SECONDS=3600
